# ============================================================================
# Widget Aguas Brasil - configuracao
# ============================================================================

# Banco de dados. Padrao: SQLite local (nao exige instalacao).
# Para Postgres: postgresql://usuario:senha@host:5432/widget
DATABASE_URL=sqlite:///./widget.db

# Origens permitidas para embutir o widget (CORS), separadas por virgula.
# Em desenvolvimento, "*" libera todas. Em producao, liste os dominios.
ALLOWED_ORIGINS=*

# Confianca minima do classificador de intencao para responder por template.
CONFIDENCE_THRESHOLD=0.5

# Minutos de inatividade ate a sessao expirar.
SESSION_TIMEOUT_MINUTES=30

# ----------------------------------------------------------------------------
# Envio de e-mail do chamado (SPRINT 2). Opcional nesta fase:
# se nao configurado, o chamado e salvo e recebe protocolo, mas nao dispara
# e-mail (o sistema registra em log). Nada de mock: apenas o envio fica pendente.
# ----------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# CHAMADO_EMAIL_TO=cnarh@ana.gov.br
# CHAMADO_EMAIL_FROM=nao-responder@exemplo.gov.br

# ----------------------------------------------------------------------------
# Seguranca / anti-abuso (SPRINT 2)
# ----------------------------------------------------------------------------
# Limite de mensagens por IP por minuto no /chat.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=30

# Teto de chamados abertos por IP por dia (0 = sem limite).
# ATENCAO: os limites sao por IP. Atras de NAT institucional (prefeitura,
# cooperativa, consultoria) muitos usuarios legitimos compartilham um mesmo IP
# e podem esbarrar no teto. Reavalie estes valores - ou combine com session_id -
# se houver publico institucional relevante.
TICKET_CAP_PER_DAY=5

# Sal para hashear o IP antes de armazenar/registrar (TROCAR em producao).
IP_HASH_SALT=trocar-este-sal-em-producao

# Tentativas no desafio anti-robo e no codigo de e-mail.
MAX_TENTATIVAS=3

# Token para consultar GET /admin/duvidas (log de perguntas nao/mal-respondidas),
# via header X-Admin-Token. Vazio (padrao) = endpoint desligado (404).
ADMIN_TOKEN=

# ----------------------------------------------------------------------------
# IA ancorada no FAQ (SPRINT 3) - agnostica de provedor
# ----------------------------------------------------------------------------
# Provedor: "gemini" (ativo/testado) ou "openai" (Azure OpenAI ou OpenAI direto).
LLM_PROVIDER=gemini

# --- Gemini (Google AI Studio) ---
# Chave (https://aistudio.google.com/app/apikey). Sem chave (no provedor gemini),
# a IA fica DESLIGADA e o bot usa so as camadas deterministicas.
GOOGLE_API_KEY=
# ATENCAO: o id 'gemini-2.5-flash-lite' e bloqueado para chaves novas (404). Use
# um id que sua chave aceite - 'gemini-3.1-flash-lite' foi verificado.
GEMINI_MODEL=gemini-3.1-flash-lite
# Fallback do Gemini em 429 (limite/quota). Vazio = off. Requer faturamento e id valido.
GEMINI_MODEL_PAID=

# --- OpenAI (producao na nuvem da ANA; tokens custeados pela ANA) ---
# Ative com LLM_PROVIDER=openai. Endpoint: OpenAI direto ou Azure OpenAI in-tenant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Fallback em 429 (limite). Ex.: um modelo maior. Vazio = off.
OPENAI_MODEL_FALLBACK=
# OpenAI direto: https://api.openai.com/v1
# Azure OpenAI: https://SEU-RECURSO.openai.azure.com/openai/deployments/SEU-DEPLOYMENT
OPENAI_BASE_URL=https://api.openai.com/v1

# Tempo maximo (segundos) por tentativa de chamada a IA (ha 1 retentativa em
# falha transitoria). Ao esgotar, cai no fallback deterministico.
LLM_TIMEOUT=8
